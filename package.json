{
  "name": "project-tracker-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "db:setup": "npm run db:setup -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
